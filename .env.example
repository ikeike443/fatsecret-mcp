# --- FatSecret API credentials (this server <-> FatSecret) ---------------
# See README's "Two authentication layers" section for why there are two
# separate credential pairs below.

# OAuth 2.0 Client ID/Secret from the FatSecret developer console — used
# for "Signed Request" methods (foods.search, food.get, recipes.search,
# recipe.get, food.find_id_for_barcode). No per-user authorization needed.
# NOTE: FatSecret requires the IP requesting OAuth2 tokens to be allowlisted
# in the developer console (up to 15 addresses/ranges) — add your Vercel
# deployment's outbound IP(s) there, or requests will fail.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Space-delimited OAuth2 scope(s) to request. "basic" covers foods/recipes
# search+detail. Add "barcode" for find_food_by_barcode, "premier" if your
# plan includes Premier-gated data. Only change this if you need those.
# FATSECRET_OAUTH2_SCOPE=basic

# OAuth 1.0 Consumer Key/Secret from the FatSecret developer console (NOT
# the same as the OAuth 2.0 Client ID/Secret above) — used to sign the
# one-time 3-legged setup (scripts/fatsecret-oauth-setup.ts) and every
# "Signed & Delegated Request" method (diary, weight, exercise, profile,
# favorites). Required even after setup, since every delegated API call is
# signed with these plus the access token/secret below.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# Filled in automatically by `npm run fatsecret:oauth-setup` (README Phase
# 3) — leave blank until you've run that once. Required for every
# diary/weight/exercise/profile/favorites tool; not needed for
# search_foods/get_food_detail/search_recipes/get_recipe_detail/
# find_food_by_barcode.
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_TOKEN_SECRET=

# --- This server's own auth (Claude <-> this server) ----------------------

# Shared secret this server checks on every request (Authorization: Bearer <token>).
# Also the value returned as access_token by the OAuth flow below, so it
# doesn't matter which path a client used to get it.
MCP_BEARER_TOKEN=

# Credentials for this server's own minimal OAuth 2.1 authorization server
# (see "Connect to Claude" below for why this exists). OAUTH_CLIENT_SECRET
# is also used as the HMAC signing key for short-lived authorization codes.
# All three of MCP_BEARER_TOKEN, OAUTH_CLIENT_ID, and OAUTH_CLIENT_SECRET
# can be generated deterministically from one memorable master passphrase —
# see the README for the derive() recipe.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Comma-separated allowlist of hosts /api/oauth/authorize is allowed to
# redirect back to. Defaults to "claude.ai,claude.com" if unset — only
# override if Claude's OAuth redirect_uri uses a different domain.
# OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com
